{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Clean Up",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/clean.py",
            "console": "integratedTerminal",
            "pythonArgs": [
                "-W",
                "ignore"
            ],
            "env": {
                "PYTHONWARNINGS": "ignore"
            }
        },
        {
            "name": "TRSP: Train",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/train_trsp.py",
            "console": "integratedTerminal",
            "pythonArgs": [
                "-W",
                "ignore"
            ],
            "args": [
                "-c",
                "${workspaceFolder}/config/trsp/train_svc_dqn.yaml"
            ],
            "env": {
                "PYTHONWARNINGS": "ignore"
            }
        },
        {
            "name": "TRSP: Eval",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/eval_trsp.py",
            "console": "integratedTerminal",
            "pythonArgs": [
                "-W",
                "ignore"
            ],
            "args": [
                "-p",
                // "4a2adb07"
                "dijkstra",
            ],
            "env": {
                "PYTHONWARNINGS": "ignore"
            }
        },
        {
            "name": "TRSP: Infer",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/infer_trsp.py",
            "console": "integratedTerminal",
            "pythonArgs": [
                "-W",
                "ignore"
            ],
            "args": [
                "-p",
                "78d5748e"
            ],
            "env": {
                "PYTHONWARNINGS": "ignore"
            }
        },
        {
            "name": "TA-EVRP: Infer",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/infer_ta_evrp.py",
            "console": "integratedTerminal",
            "pythonArgs": [
                "-W",
                "ignore"
            ],
            "args": [
                "-c",
                "${workspaceFolder}/config/ta_evrp/milp.yaml"
            ],
            "env": {
                "PYTHONWARNINGS": "ignore"
            }
