{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Dijkstras",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "args": ["-p", "dijkstra_sumo"],
            "env": {
                "PYTHONWARNINGS": "ignore"
            }
        },
        {
            "name": "Run Custom",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "args": ["-p", "dqn_sumo"],
            "env": {
                "PYTHONWARNINGS": "ignore"
            }
        },
        {
            "name": "Train",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "args": ["-c", "config/train.yaml", "-t"],
            "env": {
                "PYTHONWARNINGS": "ignore"
            }
        },
        {
            "name": "Visualize",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/visualize_sumo_simulation.py",
            "console": "integratedTerminal",
