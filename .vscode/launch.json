{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Simulation",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/run_sim.py",
            "console": "integratedTerminal",
            "pythonArgs": ["-W", "ignore"],
            "args": ["--config", "${workspaceFolder}/config/evrp/milp.yaml"],
            "env": {
                "PYTHONWARNINGS": "ignore"
            }
        },
        {
            "name": "Clean Up",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/clean.py",
            "console": "integratedTerminal",
            "pythonArgs": ["-W", "ignore"],
            "env": {
                "PYTHONWARNINGS": "ignore"
            }
        },
    ]
}
